# Local development defaults. Copy to .env and adjust as needed.
DATABASE_URL=jdbc:postgresql://localhost:5432/nevcoin
DATABASE_USERNAME=nevcoin
DATABASE_PASSWORD=nevcoin

POSTGRES_DB=nevcoin
POSTGRES_USER=nevcoin
POSTGRES_PASSWORD=nevcoin
POSTGRES_PORT=5432

# Create the local .env only after rotating any token shared in a chat or log.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram chat IDs. Group chat IDs can be negative.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_LONG_POLL_TIMEOUT_SECONDS=30
TELEGRAM_ERROR_BACKOFF_SECONDS=5

MARKET_STREAM_ENABLED=false
MARKET_STREAM_URL=wss://mainnet.helius-rpc.com
MARKET_STREAM_CHANNEL=logsSubscribe
MARKET_STREAM_RECONNECT_DELAY_SECONDS=5
MARKET_WATCHLIST_REFRESH_MS=5000
HELIUS_API_KEY=

MARKET_ENABLED=false
MARKET_WATCH_MINTS=
MARKET_OVERVIEW_ENABLED=true
MARKET_OVERVIEW_BASE_URL=https://api.dexscreener.com
MARKET_OVERVIEW_CHAIN_ID=solana
MARKET_OVERVIEW_TIMEOUT_SECONDS=10
# Initial alert default; Telegram /alerts-on and /alerts-off persist runtime overrides.
MARKET_ALERTS_ENABLED=false
MARKET_ALERT_CHAT_IDS=

# Paper trading is simulated only; it never signs or sends a blockchain transaction.
PAPER_TRADING_ENABLED=false
PAPER_POLL_INTERVAL_MS=30000
PAPER_INITIAL_CASH_USD=1000
PAPER_TRADE_NOTIONAL_USD=25
PAPER_ENTRY_MOMENTUM_THRESHOLD_PERCENT=5
PAPER_EXIT_MOMENTUM_THRESHOLD_PERCENT=-5
# Paper alerts reuse MARKET_ALERT_CHAT_IDS unless explicitly overridden.
PAPER_ALERTS_ENABLED=true
PAPER_ALERT_CHAT_IDS=
PAPER_NOTIFY_HOLD_DECISIONS=false
PAPER_HOLD_ALERT_INTERVAL_MS=300000
PAPER_MAX_OPEN_POSITIONS=5
PAPER_MAX_DAILY_LOSS_USD=100
PAPER_MAX_TRADE_NOTIONAL_USD=25
PAPER_STOP_LOSS_PERCENT=10
PAPER_TAKE_PROFIT_PERCENT=25
PAPER_FEE_PERCENT=0.30
PAPER_SLIPPAGE_BPS=50

# Social Intelligence (RSS/Atom feeds; disabled by default)
SOCIAL_ENABLED=false
SOCIAL_POLL_INTERVAL_MS=120000
SOCIAL_RSS_URLS=
SOCIAL_ALERTS_ENABLED=false
SOCIAL_ALERT_CHAT_IDS=
SOCIAL_MAX_EVENTS_PER_FEED=25

DISCOVERY_MINIMUM_LIQUIDITY_USD=10000
DISCOVERY_MINIMUM_VOLUME24H_USD=25000
DISCOVERY_MINIMUM_UNIQUE_TRADERS_5M=0
DISCOVERY_CANDIDATE_TTL_MINUTES=30
HELIUS_RPC_URL=https://mainnet.helius-rpc.com
WALLET_ENABLED=false
WALLET_POLL_INTERVAL_MS=60000
WALLET_ALERTS_ENABLED=false
WALLET_ALERT_CHAT_IDS=
